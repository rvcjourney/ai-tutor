PORT=4000
# A standard Postgres connection string. If you're running the whole app via
# `docker compose up` from the repo root, you don't need this file at all — the
# app container gets DATABASE_URL from docker-compose.yml automatically. Only
# needed for running the backend directly on your machine against your own
# Postgres (local install, or a Docker Postgres you started separately).
DATABASE_URL=postgresql://app:change-me@localhost:5432/ai_tutor
