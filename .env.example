# Copy this file to .env (same folder as docker-compose.yml) and fill in a real
# password before running `docker compose up -d`. .env is gitignored — never
# commit real credentials.

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_tutor

# The port the app is reachable on from outside the VPS, e.g. http://YOUR_VPS_IP:4000
APP_PORT=4000
